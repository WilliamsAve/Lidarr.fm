<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>NzbDrone.Core</RootNamespace>
    <AssemblyName>Lidarr.Plugin.$(MSBuildProjectName)</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version Condition="'$(PluginVersion)' != ''">$(PluginVersion)</Version>
    <Version Condition="'$(Version)' == ''">1.0.2</Version>
    <!-- Lidarr requires a numeric informational version without a commit suffix. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <EnableAnalyzers>false</EnableAnalyzers>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <Import Project="../../LidarrReferences.targets" />

  <Target Name="PackageRelease" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <ReleasePackageDir>$(IntermediateOutputPath)package/</ReleasePackageDir>
    </PropertyGroup>
    <MakeDir Directories="$(ReleasePackageDir)" />
    <Copy SourceFiles="$(TargetPath);$(TargetDir)$(TargetName).pdb;$(TargetDir)$(TargetName).deps.json" DestinationFolder="$(ReleasePackageDir)" />
    <ZipDirectory SourceDirectory="$(ReleasePackageDir)" DestinationFile="$(TargetDir)$(TargetName).net8.0.zip" Overwrite="true" />
  </Target>

</Project>
